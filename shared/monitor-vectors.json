      "context": { "usualMaxDebitBucket": null },
      "expect": { "score": 0, "severity": "info", "rules": [], "pause": false }
    },
    {
      "name": "money received is never an alert",
      "event": { "kind": "notification_credit", "app": { "package": "com.sbi.lotusintouch", "category": "bank" }, "amountBucket": "gt_1l", "call": null, "localHour": 3 },
      "context": { "usualMaxDebitBucket": null },
      "expect": { "score": 0, "severity": "info", "rules": [], "pause": false }
    },
