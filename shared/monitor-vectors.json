      "context": { "usualMaxDebitBucket": null },
      "expect": { "score": 70, "severity": "critical", "rules": ["chat_after_otp", "otp_shared_during_call"], "pause": true }
    },
    {
      "name": "chat app opened ten minutes after a code is ordinary",
      "event": { "kind": "app_foreground", "app": { "package": "org.telegram.messenger", "category": "messaging" }, "amountBucket": null, "call": null, "localHour": 11, "sinceOtpSec": 600 },
