# ---------------------------------------------------------------------------
# Co-Sign backend configuration. Copy to .env for local development.
# Every value marked REQUIRED must be set; generate secrets with the commands shown.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info
# Set to true (or the number of proxy hops) when running behind a load balancer.
TRUST_PROXY=false

# REQUIRED. Public https URL of this API, e.g. https://cosign.example.com
PUBLIC_BASE_URL=http://localhost:8080

# REQUIRED. Postgres and Redis.
DATABASE_URL=postgresql://cosign:cosign@localhost:5432/cosign?schema=public
REDIS_URL=redis://localhost:6379

# REQUIRED secrets.
# JWT_SECRET: openssl rand -base64 48
JWT_SECRET=
# DATA_ENCRYPTION_KEY / BLIND_INDEX_KEY: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
DATA_ENCRYPTION_KEY_ID=k1
# Previous keys kept for reading during rotation, comma separated "id:base64key".
DATA_ENCRYPTION_OLD_KEYS=
BLIND_INDEX_KEY=

# REQUIRED WebAuthn relying party. RP_ID is your domain without scheme or port.
RP_ID=localhost
RP_NAME=Co-Sign
# Browser origins allowed to use passkeys (the security dashboard).
WEB_ORIGINS=http://localhost:5173,http://localhost:8080
# Browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173

# Android app: package name and SHA-256 signing certificate fingerprint(s), colon hex
# (keytool -list -v -keystore release.jks). Used for assetlinks.json and the
# android:apk-key-hash passkey origin.
ANDROID_PACKAGE=app.cosign.mobile
ANDROID_SHA256_CERT_FINGERPRINTS=
# iOS app: used for apple-app-site-association.
APPLE_TEAM_ID=
IOS_BUNDLE_ID=app.cosign.mobile

# Firebase service account JSON, base64 encoded (base64 -w0 service-account.json).
# Enables guardian push notifications. Optional but strongly recommended.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Play Integrity (Android device integrity rule).
PLAY_INTEGRITY_ENABLED=false
# Defaults to the Firebase service account when empty. Needs the Play Integrity API enabled.
PLAY_INTEGRITY_SERVICE_ACCOUNT_BASE64=
# Set to false when you distribute a sideloaded release APK instead of using Google Play.
PLAY_INTEGRITY_REQUIRE_PLAY_RECOGNIZED=true
# Google Cloud project number linked to Play Integrity (sent to the app).
GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional SMS (phone-number verification and recovery alerts).
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Timings (seconds).
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
ADMIN_REFRESH_TOKEN_TTL_SECONDS=43200
STEPUP_GUARDIAN_WINDOW_SECONDS=600
COOLOFF_SECONDS=1800
GUARDIAN_CHANGE_DELAY_SECONDS=86400
INVITE_TTL_SECONDS=172800
RECOVERY_APPROVAL_WINDOW_SECONDS=86400
RECOVERY_CANCEL_WINDOW_SECONDS=86400
SIGNAL_RETENTION_DAYS=30
MAX_GUARDIANS=5

# Extra remote-access app package names delivered to the app (comma separated).
REMOTE_ACCESS_PACKAGES_EXTRA=

# Time zone used when the server words times in messages (the app uses the phone's zone).
DISPLAY_TIMEZONE=Asia/Kolkata
# Path to the built dashboard (dashboard/dist) to serve it from this origin. Empty = not served.
DASHBOARD_DIST=
JOBS_ENABLED=true
JOB_INTERVAL_MS=5000
