<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Passkeys for the relying party and universal links for invites. Set COSIGN_DOMAIN in Flutter/*.xcconfig. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(COSIGN_DOMAIN)</string>
		<string>applinks:$(COSIGN_DOMAIN)</string>
	</array>
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
